DATABASE_URL="postgresql://ranger:ranger@localhost:5432/ranger"
SESSION_SECRET="change-me"
DEPLOY_KEY_ENCRYPTION_KEY="change-me-32-bytes-min"
PORT=3000

# Email первого администратора — создаётся при старте на пустой базе, пароль в логе.
ADMIN_EMAIL="admin@example.com"

# В dev backend запускается не в контейнере — он сам является "хостом" для Docker-демона,
# поэтому оба пути совпадают (в docker-compose они разные, см. корневой .env.example).
BUILD_WORKDIR_CONTAINER_PATH=/tmp/ranger-build-workdir
BUILD_WORKDIR_HOST_PATH=/tmp/ranger-build-workdir
