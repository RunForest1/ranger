SESSION_SECRET=change-me
DEPLOY_KEY_ENCRYPTION_KEY=change-me-32-bytes-minimum

# Абсолютный путь на ХОСТЕ (не внутри контейнера), под чекауты репозиториев сборки.
# Backend ходит в Docker через сокет хоста, поэтому bind-mount контейнера сборки должен
# резолвиться демоном относительно хоста — см. README и комментарий в docker-compose.yml.
RANGER_WORKDIR_HOST_PATH=/srv/ranger/build-workdir

# Email первого администратора. Используется только при старте на пустой базе:
# пароль генерируется и один раз печатается в `docker compose logs backend`.
# Остальных пользователей admin заводит сам на вкладке «Пользователи».
ADMIN_EMAIL="admin@example.com"
